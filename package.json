{
  "name": "toko-online-umkm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/reset-demo.ts",
    "art": "tsx scripts/generate-art.ts",
    "deploy": "bash deploy/deploy.sh",
    "rekam-animasi": "playwright test --project=animasi",
    "test:e2e:publik": "E2E_BASE_URL=$(sed -n \"s/^TOKO_URL=//p\" /root/tenma-ws/portofolio/domain.env) playwright test --project=e2e",
    "uji-rate-limit": "node scripts/uji-rate-limit.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
