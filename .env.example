# Salin ke .env.local untuk pengembangan. Jangan commit nilai asli.
SITE_URL=http://localhost:3000
# Minimal 32 karakter acak: openssl rand -base64 48
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
DATABASE_PATH=./data/toko.db
UPLOAD_DIR=./data/uploads
# Opsional: file kredensial admin asli untuk `npm run db:setup` (format "Email: ..." dan "Password: ...")
# ADMIN_CREDENTIALS_FILE=/path/ke/kredensial.txt
